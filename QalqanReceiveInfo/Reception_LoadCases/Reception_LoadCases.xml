  <response>
    <data xmlns:q1="http://integrations.gosreestr.kz" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="q1:IntegraResponse">
      <ResponseInfo>
        <RequestType>Reception_LoadCases</RequestType>
        <StatusCode>200</StatusCode>
        <Message>OK</Message>
      </ResponseInfo>
      <Reception_LoadCasesResponse>
        <Total>1</Total>
        <Inserted>1</Inserted>
        <Updated>0</Updated>
        <Unchanged>0</Unchanged>
        <Errors></Errors>
      </Reception_LoadCasesResponse>
    </data>
  </response>
</example>
